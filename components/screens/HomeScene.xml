<?xml version="1.0" encoding="utf-8" ?>
<component name="HomeScene" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/screens/HomeScene.brs" />
    <script type="text/brightscript" uri="pkg:/utils/Logger.brs" />

    <interface>
        <field id="content"       type="node" onChange="onContentChanged" />
        <field id="selectedVideo" type="node" />
    </interface>

    <children>
        <!-- Full-screen dark canvas -->
        <Rectangle id="canvasBg" width="1920" height="1080" color="0x090611FF" />

        <!-- Ambient glow top-right -->
        <Rectangle id="ambientGlow" translation="[1340, 0]" width="580" height="580"
                   color="0x662D911A" blendingEnabled="true" />

        <!-- ══ NAV BAR  y=0–50 ══════════════════════════════════════════════ -->
        <Rectangle id="navBarBg" width="1920" height="50" color="0x0D091EFF" />

        <Rectangle id="navLogoIcon" translation="[110, 13]" width="24" height="24"
                   color="0x662D91FF" />

        <Label id="navChannelName" text="Roku OS TV"
               translation="[142, 14]" width="160" height="24"
               font="font:SmallBoldSystemFont" color="0xFFFFFFFF" />

        <Rectangle id="navBadgeBg" translation="[310, 15]" width="118" height="20"
                   color="0x2E106566" blendingEnabled="true" />
        <Label id="navBadgeLabel" text="Playlet Pattern"
               translation="[312, 16]" width="114" height="18"
               font="font:SmallSystemFont" color="0xC4B5FDFF" horizAlign="center" />

        <!-- Category tab bar — focusable, populated dynamically from row titles -->
        <CategoryNav id="categoryNav" translation="[454, 13]" />

        <Label id="navRemoteHint" text="Use D-Pad remote"
               translation="[1700, 14]" width="210" height="24"
               font="font:SmallSystemFont" color="0x4B5563FF" horizAlign="right" />

        <Rectangle id="navDivider" translation="[0, 50]" width="1920" height="1"
                   color="0x4C1D9540" blendingEnabled="true" />

        <!-- ══ HERO BANNER  y=51–375 ════════════════════════════════════════ -->
        <Rectangle id="heroBannerBg" translation="[80, 51]" width="1760" height="324"
                   color="0x140E24F0" blendingEnabled="true" />

        <Rectangle id="badgeDestaqueBg" translation="[110, 72]" width="88" height="22"
                   color="0x662D9166" blendingEnabled="true" />
        <Label id="badgeDestaque" text="Destaque"
               translation="[115, 72]" width="78" height="22"
               font="font:SmallBoldSystemFont" color="0xC4B5FDFF"
               horizAlign="center" vertAlign="center" />

        <Label id="focusedCategory" text=""
               translation="[210, 72]" width="200" height="22"
               font="font:SmallBoldSystemFont" color="0xDDD6FEFF" vertAlign="center" />

        <Label id="focusedRating" text=""
               translation="[426, 72]" width="72" height="22"
               font="font:SmallBoldSystemFont" color="0xDDD6FEFF" vertAlign="center" />

        <Label id="focusedYear" text=""
               translation="[510, 72]" width="130" height="22"
               font="font:SmallSystemFont" color="0x9CA3AFFF" vertAlign="center" />

        <Label id="focusedTitle" text=""
               translation="[110, 104]" width="960" height="66"
               font="font:LargeBoldSystemFont" color="0xFFFFFFFF" wrap="true" />

        <Label id="focusedDesc" text=""
               translation="[110, 182]" width="960" height="76"
               font="font:SmallSystemFont" color="0xD1D5DBFF" wrap="true" />

        <Rectangle id="playBtnBg" translation="[110, 274]" width="248" height="46"
                   color="0x662D91FF" />
        <Label id="playBtnLabel" text="&gt;  Assistir  (OK)"
               translation="[110, 282]" width="248" height="30"
               font="font:MediumBoldSystemFont" color="0xFFFFFFFF" horizAlign="center" />

        <Rectangle id="durationPillBg" translation="[368, 274]" width="132" height="46"
                   color="0x1E172EFF" />
        <Label id="focusedDuration" text=""
               translation="[376, 284]" width="120" height="26"
               font="font:SmallSystemFont" color="0x9CA3AFFF" />

        <!-- Poster (right side of hero) -->
        <Rectangle id="posterBg" translation="[1160, 63]" width="660" height="288"
                   color="0x1A122BFF" />
        <Poster id="focusedPoster" translation="[1160, 63]" width="660" height="288"
                loadDisplayMode="scaleToZoom" />
        <Rectangle id="posterFade" translation="[1160, 63]" width="80" height="288"
                   color="0x140E24C0" blendingEnabled="true" />
        <Label id="posterChipLabel" text="Roku Video Player Target"
               translation="[1536, 328]" width="270" height="22"
               font="font:SmallSystemFont" color="0x7C3AEDFF" horizAlign="right" />

        <Rectangle id="heroBorder" translation="[80, 375]" width="1760" height="1"
                   color="0x3B1F6060" blendingEnabled="true" />

        <!-- ══ ROWLIST  y=410 ════════════════════════════════════════════════ -->
        <RowList id="rowList"
                 translation="[80, 410]"
                 itemSize="[1760, 230]"
                 numRows="2"
                 itemSpacing="[0, 80]"
                 rowLabelOffset="[0, -30]"
                 itemComponentName="VideoRowListItem"
                 rowFocusAnimationStyle="floatingFocus" />
    </children>
</component>
