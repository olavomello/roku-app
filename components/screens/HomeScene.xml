<?xml version="1.0" encoding="utf-8" ?>
<component name="HomeScene" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/screens/HomeScene.brs" />

    <interface>
        <field id="content" type="node" onChange="onContentChanged" />
        <field id="selectedVideo" type="node" />
    </interface>

    <children>
        <Label id="titleLabel" text="Roku Channel Catalog" translation="[100, 60]" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
        <RowList 
            id="rowList" 
            translation="[100, 150]" 
            itemSize="[1720, 320]" 
            numRows="3"
            rowItemSize="[[300, 180]]" 
            rowItemSpacing="[[30, 0]]"
            itemSpacing="[0, 40]" 
            itemComponentName="VideoRowListItem"
            rowFocusAnimationStyle="floatingFocus" />
    </children>
</component>
